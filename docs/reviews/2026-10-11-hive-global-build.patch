+import json
+import sys
+
+from hive.coach_report import publish
+
+
+def test_provider_failure_is_preserved_and_never_published_as_a_diagnosis(tmp_path):
+    var, out = tmp_path / 'var', tmp_path / 'out'
+    status = publish(var, out, 'one', [sys.executable, '-c',
+                     'print("weekly limit reached"); raise SystemExit(1)'])
+    assert status['state'] == 'degraded' and not status['model_diagnosis']
+    assert 'weekly limit reached' in (var / 'logs/coach-one.stdout').read_text()
+    assert 'evidence-only fallback' in (out / 'latest.md').read_text()
+    assert not (out / 'latest-diagnosis.md').exists()
+    # Cooldown uses the evidence fallback without invoking an unavailable provider again.
+    publish(var, out, 'two', ['/no/provider/here'])
+    assert not (var / 'logs/coach-two.stderr').exists()
+
+
+def test_successful_provider_keeps_real_diagnosis_separate(tmp_path):
+    var, out = tmp_path / 'var', tmp_path / 'out'
+    status = publish(var, out, 'one', [sys.executable, '-c', 'print("verified report")'])
+    assert status['model_diagnosis']
+    assert (out / 'latest-diagnosis.md').read_text() == 'verified report\n'
+    publish(var, out, 'two', [sys.executable, '-c', 'raise SystemExit(1)'])
+    assert (out / 'latest-diagnosis.md').read_text() == 'verified report\n'
+    assert not json.loads((var / 'coach-status.json').read_text())['model_diagnosis']
