+++ b/tests/test_trials.py
@@ -0,0 +1,165 @@
+import json
+import sqlite3
+import subprocess
+
+import pytest
+
+from hive import canary, config, reward, trials
+
+
+def test_coach_report_updates_do_not_invalidate_runtime_identity(tmp_path):
+    def git(*args):
+        return subprocess.run(['git', '-C', str(tmp_path), *args], check=True,
+                              capture_output=True)
+    git('init', '-q')
+    (tmp_path / 'docs').mkdir()
+    (tmp_path / 'hive').mkdir()
+    (tmp_path / 'docs/latest.md').write_text('old diagnosis')
+    (tmp_path / 'hive/main.py').write_text('code')
+    git('add', 'docs/latest.md', 'hive/main.py')
+    git('-c', 'user.name=Test', '-c', 'user.email=test@example.invalid', 'commit', '-qm', 'base')
+    identity = trials.code_identity(tmp_path)
+    (tmp_path / 'docs/latest.md').write_text('updated measurements')
+    assert trials.code_identity(tmp_path) == identity
+    (tmp_path / 'hive/main.py').write_text('changed runtime')
+    assert trials.code_identity(tmp_path) != identity
+
+
+def prepared(tmp_path, monkeypatch):
+    monkeypatch.setattr(config, "HOME", tmp_path)
+    monkeypatch.setattr(config, "JEV", tmp_path / "jev")
+    var = tmp_path / "var"
+    var.mkdir()
+    (var / "choices.json").write_text('{"points": {"a": 1}}')
+    (var / "values.json").write_text('{"format": 1}')
+    doc = {"set":10., "commit":"a"*40, "base":"b"*40, "assignment_seed":11,
+           "procs":[0,2,4], "of":8, "cohort":[1,2,3]}
+    doc.update(trials.prepare(doc, var=var, pace={1:100.}))
+    return doc, var
+
+
+def test_trial_arms_start_equal_but_cannot_write_each_others_learning(tmp_path, monkeypatch):
+    doc, var = prepared(tmp_path, monkeypatch)
+    root = __import__('pathlib').Path(doc['trial_manifest']).parent
+    assert (root/'candidate/choices.json').read_bytes() == (root/'control/choices.json').read_bytes()
+    (root/'candidate/choices.json').write_text('{"changed":true}')
+    assert (root/'control/choices.json').read_bytes() == (var/'choices.json').read_bytes()
+    monkeypatch.setattr(trials, "active", lambda docs=None:doc)
+    monkeypatch.setenv("HIVE_TRIAL_TOKEN",trials.token((0,8),[doc]))
+    for name in ("HIVE_LEARNING_ROOT", "HIVE_PARITY", "HIVE_TRIAL_INPUTS", "HIVE_TRIAL_MANIFEST", "JEV_TRIPS", "HIVE_COACH_OVERRIDE"):
+        monkeypatch.setenv(name, "")
+    trials.configure((0,8))
+    assert trials.learning_root() == root/'candidate'
+    import os
+    parts = os.environ["HIVE_PARITY"]
+    monkeypatch.setenv("HIVE_TRIAL_TOKEN",trials.token((1,8),[doc]))
+    trials.configure((1,8))
+    assert trials.learning_root() == root/'control'
+    assert os.environ["HIVE_PARITY"] == parts
+    # configure writes these directly; restore them after this standalone probe.
+    for name in ('HIVE_LEARNING_ROOT','HIVE_PARITY','HIVE_TRIAL_INPUTS','HIVE_TRIAL_MANIFEST'):
+        monkeypatch.delenv(name)
+
+
+def test_frozen_manifest_tampering_and_wrong_assignment_are_rejected(tmp_path, monkeypatch):
+    doc, _ = prepared(tmp_path,monkeypatch)
+    monkeypatch.setattr(trials,"active",lambda docs=None:doc)
+    monkeypatch.setenv("HIVE_TRIAL_TOKEN", "wrong")
+    with pytest.raises(ValueError,match="restart"): trials.configure((0,8))
+    path = __import__('pathlib').Path(doc['trial_manifest'])
+    path.write_text(path.read_text() + ' ')
+    with pytest.raises(ValueError,match="changed"): trials.read(doc)
+
+
+def test_reference_curve_cannot_learn_from_after_assignment():
+    con = sqlite3.connect(':memory:'); con.row_factory=sqlite3.Row
+    con.execute('create table dings(guid integer,level integer,played integer,at real,source text)')
+    con.executemany('insert into dings values(?,?,?,?,?)',[(1,1,0,1,'server'),
+                    (1,2,10,2,'server'),(2,1,0,3,'server'),(2,2,1000,4,'server')])
+    assert reward.curve(con,{1:100},min_count=1,top=1,before=2)[1] == 10
+    assert reward.curve(con,{1:100},min_count=1,top=1)[1] == 505
+
+
+def test_assignment_is_seeded_balanced_and_excludes_reserved_processes():
+    args = dict(n=8,exclude={7},seed=14,strata={g:g%3 for g in range(200)})
+    a=canary.pick_set(range(200),**args)
+    assert a == canary.pick_set(iter(range(200)),**args)
+    assert 7 not in a[0] and len(a[0])==3
+
+
+def arms(gain=0):
+    speed,events={},{}
+    for arm,delta in [('candidate',gain),('control',0)]:
+        speed[arm]=[dict(cluster=k,base_index=1.,index=1.+delta,change=delta,
+                         played_s=7200,base_played_s=7200,deaths=3,base_deaths=3)
+                    for k in range(3) for _ in range(5)]
+        events[arm]=[dict(cluster=k,s=7200,bs=7200,deaths=3,bdeaths=3,
+                          idle=100,bidle=100,stuck=2,bstuck=2,target=10,btarget=10)
+                     for k in range(3) for _ in range(5)]
+    return events,speed
+
+
+def test_identical_code_is_noninferior_but_not_an_improvement():
+    result=trials.evaluate(*arms())
+    assert result['status']=='noninferior' and result['outcome']!='kept'
+    assert trials.evaluate(*arms(.2))['status']=='improved'
+    assert trials.evaluate(*arms(-.2))['status']=='harmful'
+
+
+def test_one_process_cannot_masquerade_as_many_independent_characters():
+    ev,sp=arms(.5)
+    for rows in (*ev.values(),*sp.values()):
+        for row in rows: row['cluster']=0
+    assert trials.evaluate(ev,sp)['status']=='inconclusive'
+
+
+def test_mutated_assignment_and_absent_event_evidence_are_not_qualified(tmp_path,monkeypatch):
+    doc,_=prepared(tmp_path,monkeypatch)
+    doc['procs']=[1,3,5]
+    with pytest.raises(ValueError,match='assignment changed'): trials.read(doc)
+    ev,sp=arms(.2)
+    for rows in ev.values():
+        for row in rows: row['stuck']=row['bstuck']=0
+    assert trials.evaluate(ev,sp)['status']=='inconclusive'
+
+
+def test_fixed_trial_is_not_repicked_to_a_different_process_split():
+    assert canary._repick({'protocol':2},16,lambda _:None) is None
+
+
+def test_pending_contract_does_not_override_an_unassigned_farm(monkeypatch):
+    monkeypatch.setenv('HIVE_TRIAL_TOKEN','-')
+    monkeypatch.setattr(trials,'active',lambda:pytest.fail('pending trial was consulted'))
+    trials.configure((0,8))
+
+
+def test_measurement_uses_fixed_target_window_and_never_calls_merge(tmp_path,monkeypatch):
+    doc,_=prepared(tmp_path,monkeypatch)
+    doc.update(started=True,since=100.,target=None)
+    calls=[]
+    ev,sp=arms(.2)
+    def score(target,since,until,ks,n,**kw):
+        calls.append((since,until,kw))
+        return ev,sp,[],0
+    result=trials.measure(doc,100+21600+10000,dry_run=True,log=lambda _:None,
+                          scorer=score,slot='a')
+    assert result['outcome']=='measured' and not result['merged']
+    assert calls[0][0:2]==(100.,21700.)
+    assert calls[0][2]['actual_time'] and calls[0][2]['cohort']==[1,2,3]
+    with pytest.raises(ValueError,match='target cannot change'):
+        trials.measure(doc,100+21600+10000,dry_run=True,log=lambda _:None,
+                       scorer=score,slot='a',target={'decide':'deaths'})
+
+
+def test_next_level_report_retains_censored_assigned_characters(tmp_path):
+    db=tmp_path/'lineage.sqlite'
+    con=sqlite3.connect(db)
+    con.executescript('create table samples(guid integer,at real,level integer,played real);'
+                      'create table dings(guid integer,level integer,played real,at real);')
+    con.executemany('insert into samples values(?,?,?,?)',[(1,100,5,0),(2,100,5,0),(2,200,5,70)])
+    con.execute('insert into dings values(1,6,60,180)');con.commit();con.close()
+    result=trials.milestones({'cohort':[1,2,3],'procs':[0,2,4],'of':8,'since':100},200,db=db)
+    a,b,c=result['rows']
+    assert not a['censored'] and a['played_s']==60
+    assert b['censored'] and b['played_s']==70
+    assert c['censored'] and c['played_s'] is None
