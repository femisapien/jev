+from pathlib import Path
+
+import pytest
+
+from hive import coaching, farm, patches, trials
+from hive.run import match_live_exploration
+from jev.run.body import LiveBody
+from types import SimpleNamespace
+
+
+def test_trial_setup_supports_shared_runtimes_without_optional_exploration(monkeypatch):
+    monkeypatch.delattr(LiveBody, 'EXPLORE', raising=False)
+    monkeypatch.delattr(LiveBody, 'UNIFORM', raising=False)
+    body = SimpleNamespace()
+    match_live_exploration(body)
+    assert vars(body) == {}
+    monkeypatch.setattr(LiveBody, 'EXPLORE', .1, raising=False)
+    monkeypatch.setattr(LiveBody, 'UNIFORM', 0., raising=False)
+    body.EXPLORE, body.UNIFORM = .25, .05
+    match_live_exploration(body)
+    assert (body.EXPLORE, body.UNIFORM) == (.1, 0.)
+
+
+@pytest.mark.parametrize('mode', ['rules', 'model'])
+def test_farm_entrypoint_applies_trial_policy_before_starting_workers(monkeypatch, mode):
+    monkeypatch.setattr(farm, 'held_bots', lambda: [
+        {'guid': 1, 'map': 0, 'race': 1, 'class': 8, 'level': 16, 'name': 'Fixture'}])
+    monkeypatch.setattr(farm, 'guide_for', lambda bot: Path('fixture.json'))
+    monkeypatch.setattr(patches, 'apply', lambda **kw: [])
+    monkeypatch.setattr(coaching, 'arms', lambda bots: {1: coaching.JEV})
+    coach = object()
+    monkeypatch.setattr(coaching, 'open_coach', lambda **kw: coach)
+    configured = []
+    def configure(shard):
+        configured.append(shard)
+        monkeypatch.setenv('HIVE_COACH_OVERRIDE', mode)
+    monkeypatch.setattr(trials, 'configure', configure)
+    monkeypatch.setattr(farm.switch, 'start', lambda *a, **kw: None)
+    made = []
+    class Worker:
+        def __init__(self, guides, **kwargs):
+            made.append(kwargs)
+        def play(self):
+            return 0
+    monkeypatch.setattr(farm, 'Farm', Worker)
+    assert farm.main(['--all', '--shard', '0/1']) == 0
+    assert configured == [(0, 1)]
+    assert made[0]['coach'] is (None if mode == 'rules' else coach)
+    assert made[0]['coached'] == (frozenset() if mode == 'rules' else frozenset({1}))
