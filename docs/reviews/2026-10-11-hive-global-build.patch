diff --git a/hive/trials.py b/hive/trials.py
new file mode 100644
index 0000000..dd0140e
--- /dev/null
+++ b/hive/trials.py
@@ -0,0 +1,402 @@
+"""Versioned, isolated comparisons. Historical canary records remain protocol 1.
+
+Protocol 2 pins inputs before play, isolates learned files by arm, uses one observation
+contract for both arms, and evaluates a fixed window at the process assignment unit.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import random
+import shutil
+import statistics
+import time
+from pathlib import Path
+
+from hive import config
+
+PROTOCOL = 2
+MEMORIES = ("choices.json", "danger.json", "route-memory.json", "values.json",
+            "merchant-memory.json", "pull-risk.json", "rib-yield.json", "senses.json")
+
+
+def sha(path):
+    h = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            h.update(block)
+    return h.hexdigest()
+
+
+def prepare(doc, *, var=None, pace=None):
+    """Write-once inputs, identical initial learning in both arms, no active-file writes."""
+    from hive import parity
+    settings = doc.get("arm_settings", {})
+    if set(settings) - {"candidate", "control"}:
+        raise ValueError("unknown experiment arm")
+    for options in settings.values():
+        if (set(options) - {"trip_mode", "coach"}
+                or options.get("trip_mode", "shadow") not in ("off", "shadow", "active")
+                or options.get("coach", "roster") not in ("roster", "rules", "model")):
+            raise ValueError("invalid pinned arm settings")
+    var = Path(var or config.VAR)
+    ident = f"{int(doc['set'] * 1000)}-{doc['commit'][:12]}"
+    root = var / "trials" / ident
+    root.mkdir(parents=True, exist_ok=False)
+    frozen = root / "inputs"
+    frozen.mkdir()
+    hashes = {}
+    for name in MEMORIES:
+        source = var / name
+        if source.is_file():
+            shutil.copy2(source, frozen / name)
+            hashes[name] = sha(frozen / name)
+    characters = var / "characters"
+    if characters.is_dir():
+        (frozen / "characters").mkdir()
+        for source in sorted(characters.glob("*.json")):
+            target = frozen / "characters" / source.name
+            shutil.copy2(source, target)
+            hashes["characters/" + source.name] = sha(target)
+    route_source = config.HOME / "content" / "routes"
+    (frozen / "routes").mkdir()
+    sources = {p.name: p for folder in (config.JEV / "content" / "tbc",
+                                       config.HOME / "content" / "guides", route_source)
+               for p in folder.glob("*.json")}
+    for source in sorted(sources.values()):
+        target = frozen / "routes" / source.name
+        shutil.copy2(source, target)
+        hashes["routes/" + source.name] = sha(target)
+    for arm in ("candidate", "control"):
+        dest = root / arm
+        dest.mkdir()
+        if (frozen / "characters").is_dir():
+            shutil.copytree(frozen / "characters", dest / "characters")
+        for name in MEMORIES:
+            if (frozen / name).exists():
+                shutil.copy2(frozen / name, dest / name)
+    if pace is None:
+        from hive import lineage, reward
+        from hive.canary import sqlite_ro
+        from hive.calibrate import xp_table
+        pace = {}
+        if lineage.DB.exists():
+            con = sqlite_ro(lineage.DB)
+            try:
+                pace = reward.curve(con, xp_table(), before=doc["set"])
+            finally:
+                con.close()
+    manifest = {"protocol": PROTOCOL, "id": ident, "set": doc["set"],
+                "candidate": doc["commit"], "control": doc["base"],
+                "seed": doc["assignment_seed"], "procs": doc["procs"], "of": doc["of"],
+                "target": doc.get("target"), "measure": bool(doc.get("measure")), "arm_settings": settings,
+                "hive_code": code_identity(config.HOME),
+                "world": artifact(config.FOREVER / "data" / "knowledge" / "tbc-243.sqlite"),
+                "choice_seed": "sha256(trial id:character guid)", "python_hash_seed": 0,
+                "cohort": doc.get("cohort", []), "normalization": pace,
+                "parity": sorted(parity.ALL), "tier": "client-contract-simulator",
+                "danger_learning": "frozen during comparison", "inputs": hashes,
+                "unit": "farm process", "window_s": doc.get("min_s", 6 * 3600),
+                "metric": "normalized progress / actual played time",
+                "utility_death_penalty_s": 120,
+                "environment_interference": "shared realm; cluster analysis cannot remove spawn interference"}
+    path = root / "manifest.json"
+    path.write_text(json.dumps(manifest, indent=2) + "\n")
+    return {"protocol": PROTOCOL, "trial_id": ident, "trial_manifest": str(path),
+            "trial_manifest_sha256": sha(path)}
+
+
+def read(doc):
+    path = Path(doc["trial_manifest"])
+    if sha(path) != doc["trial_manifest_sha256"]:
+        raise ValueError("trial manifest changed after assignment")
+    manifest = json.loads(path.read_text())
+    for key, field in (("candidate", "commit"), ("control", "base"),
+                       ("procs", "procs"), ("of", "of"), ("cohort", "cohort"),
+                       ("seed", "assignment_seed"), ("target", "target")):
+        if manifest.get(key) != doc.get(field):
+            raise ValueError(f"trial assignment changed: {field}")
+    if manifest.get("arm_settings", {}) != doc.get("arm_settings", {}):
+        raise ValueError("trial arm settings changed after assignment")
+    return manifest
+
+
+def active(docs=None):
+    if docs is None:
+        from hive import canary
+        docs = [canary.load(canary.slot_path(s)) for s in canary.SLOTS]
+    found = [d for d in docs if d and d.get("protocol") == PROTOCOL]
+    if len(found) > 1:
+        raise ValueError("isolated comparisons require one active trial")
+    return found[0] if found else None
+
+
+def token(shard, docs=None):
+    doc = active(docs)
+    if doc is None or shard is None:
+        return "-"
+    k, n = shard
+    if n != doc["of"]:
+        raise ValueError("farm split differs from the trial assignment")
+    arm = "candidate" if k in doc["procs"] else "control"
+    return doc["trial_id"] + ":" + arm
+
+
+def configure(shard):
+    # A queued candidate does not change farms until the scheduler admits its suite.
+    if os.environ.get("HIVE_TRIAL_TOKEN", "-") == "-":
+        return
+    doc = active()
+    if doc is None:
+        raise ValueError("trial assignment no longer exists; restart under the scheduler")
+    manifest = read(doc)
+    if code_identity(config.HOME) != manifest["hive_code"]:
+        raise ValueError("hive adapter changed after assignment")
+    world = manifest.get("world", {})
+    if world.get("sha256") and sha(world["path"]) != world["sha256"]:
+        raise ValueError("world catalog changed after assignment")
+    if not manifest["normalization"]:
+        raise ValueError("trial has no frozen reference curve; prepare a new measured comparison")
+    expected = token(shard, [doc])
+    if os.environ.get("HIVE_TRIAL_TOKEN") != expected:
+        raise ValueError("farm must restart under the recorded trial assignment")
+    root = Path(doc["trial_manifest"]).parent
+    arm = expected.rsplit(":", 1)[1]
+    settings = manifest.get("arm_settings", {}).get(arm, {})
+    os.environ["JEV_TRIPS"] = settings.get("trip_mode", "shadow")
+    os.environ["HIVE_COACH_OVERRIDE"] = settings.get("coach", "roster")
+    os.environ["HIVE_LEARNING_ROOT"] = str(root / arm)
+    os.environ["HIVE_PARITY"] = ",".join(manifest["parity"])
+    os.environ["HIVE_TRIAL_INPUTS"] = str(root / "inputs")
+    os.environ["HIVE_TRIAL_MANIFEST"] = doc["trial_manifest"]
+    for name, expected_hash in manifest["inputs"].items():
+        if sha(root / "inputs" / name) != expected_hash:
+            raise ValueError(f"frozen trial input changed: {name}")
+
+
+def learning_root():
+    return Path(os.environ.get("HIVE_LEARNING_ROOT") or config.VAR)
+
+
+def route_path(path):
+    root = os.environ.get("HIVE_TRIAL_INPUTS")
+    if not root:
+        return path
+    frozen = Path(root) / "routes" / Path(path).name
+    if not frozen.exists():
+        raise ValueError(f"route {Path(path).name} was not frozen for this trial")
+    return frozen
+
+
+def cluster_interval(a, b, statistic, *, seed=11, draws=2000):
+    """Resample the assigned processes, preserving all characters in each process."""
+    def group(rows):
+        result = {}
+        for row in rows:
+            result.setdefault(row["cluster"], []).append(row)
+        return list(result.values())
+    left, right = group(a), group(b)
+    if min(len(left), len(right)) < 3:
+        return None
+    rng = random.Random(seed)
+    samples = sorted(statistic([r for g in rng.choices(left, k=len(left)) for r in g],
+                               [r for g in rng.choices(right, k=len(right)) for r in g])
+                     for _ in range(draws))
+    return [samples[int(draws * .05)], samples[min(draws - 1, int(draws * .95))]]
+
+
+def evaluate(events, speed, *, decide="speed", correctness=False):
+    from hive import canary
+    a, b = speed["candidate"], speed["control"]
+    enough = (min(len(a), len(b)) >= canary.MIN_CHARACTERS
+              and min(sum(r["played_s"] for r in rows) / 3600 for rows in (a,b)) >= canary.MIN_HOURS)
+    def speed_difference(left, right):
+        copied = {"candidate":[dict(r) for r in left], "control":[dict(r) for r in right]}
+        canary.adjust(copied)  # refit the adjustment inside every bootstrap
+        return (statistics.median(r["adjusted"] for r in copied["candidate"])
+                - statistics.median(r["adjusted"] for r in copied["control"]))
+    interval = cluster_interval(a, b, speed_difference) if enough else None
+    baseline = statistics.median(r["base_index"] for r in b) if b else 0
+    checks = {"speed": {"interval": interval, "floor": -.05 * baseline,
+                         "difference": speed_difference(a,b) if a and b else None}}
+    for key in ("deaths", "idle", "stuck", "target"):
+        rows_a, rows_b = events["candidate"], events["control"]
+        # A degenerate bootstrap of rare/absent events cannot establish noninferiority.
+        enough_events = all(sum(r.get(k, 0) for r in rows) >= 10
+                            for rows in (rows_a, rows_b) for k in (key, "b" + key))
+        bounds = (cluster_interval(rows_a, rows_b, lambda x,y: canary.rate_ratio(x,y,key))
+                  if enough_events else None)
+        checks[key] = {"interval": bounds, "ratio":canary.rate_ratio(rows_a, rows_b, key), "limit": 1.25 if key != "target" else 1.0}
+    noninferior = interval is not None and interval[0] > checks["speed"]["floor"]
+    noninferior &= all(checks[k]["interval"] is not None and checks[k]["interval"][1] <= 1.25
+                       for k in ("deaths", "idle", "stuck"))
+    improved = (interval is not None and interval[0] > 0 if decide == "speed" else
+                checks["deaths" if decide == "deaths" else "target"]["interval"] is not None
+                and checks["deaths" if decide == "deaths" else "target"]["interval"][1] < 1)
+    harmful = interval is not None and interval[1] < checks["speed"]["floor"]
+    harmful |= any(checks[k]["interval"] is not None and checks[k]["interval"][0] > 1.25
+                   for k in ("deaths", "idle", "stuck"))
+    status = ("harmful" if harmful else "improved" if noninferior and improved else
+              "noninferior" if noninferior else "inconclusive")
+    kept = status == "improved" or (correctness and status == "noninferior")
+    primary = {arm: {"characters":len(rows), "hours":sum(r["played_s"] for r in rows)/3600,
+                     "median_actual_time_index":statistics.median(r["index"] for r in rows) if rows else None,
+                     "median_utility_index":statistics.median(r.get("utility_index", r["index"]) for r in rows) if rows else None}
+               for arm, rows in speed.items()}
+    return {"primary": primary, "protocol": PROTOCOL, "status": status, "outcome": "kept" if kept else
+            "not kept" if harmful else "not enough evidence", "checks": checks,
+            "why": f"{status}: actual played time; process-cluster intervals; fixed window"}
+
+
+
+
+def coverage(doc, speed):
+    """Retain unobserved assigned characters in the report; never call them successes."""
+    result = {}
+    for arm in ("candidate", "control"):
+        assigned = [g for g in doc.get("cohort", [])
+                    if (config.shard_of_guid(g, doc["of"]) in doc["procs"]) == (arm == "candidate")]
+        observed = {r.get("guid") for r in speed.get(arm, [])}
+        result[arm] = {"assigned": len(assigned), "observed": len(observed - {None}),
+                       "unobserved_or_censored": sorted(set(assigned) - observed)}
+    return result
+
+
+def save_result(doc, result):
+    path = Path(doc["trial_manifest"]).parent / "verdict.json"
+    payload = json.dumps(result, indent=2, sort_keys=True) + "\n"
+    if path.exists() and path.read_text() != payload:
+        raise ValueError("trial already has a different final verdict")
+    path.write_text(payload)
+
+
+def measure(doc, now, *, dry_run, log, scorer, slot, target=None, stop=None):
+    """Measurement-only arm of the same fixed protocol; never merges any code."""
+    from hive import canary, reward
+    contract = read(doc)
+    until = doc["since"] + contract["window_s"]
+    if stop is None and (not doc.get("started") or now < until + reward.SETTLE_S):
+        return None
+    result = {"protocol": PROTOCOL, "status": "inconclusive", "checks": {},
+              "outcome": "not enough evidence", "why": "comparison stopped before qualification"}
+    if stop is None:
+        ev, sp, excluded, pending = scorer(contract["target"], doc["since"], until,
+                       doc["procs"], doc["of"], log=log, others=(),
+                       frozen_pace=contract["normalization"], cohort=contract["cohort"],
+                       actual_time=True)
+        if pending and now - doc["since"] < doc.get("max_s", canary.CANARY_MAX_S):
+            return {"outcome": "waiting", "why": f"{pending} fixed-window runs unread"}
+        if not pending:
+            result = evaluate(ev, sp, decide=(contract["target"] or {}).get("decide", "speed"))
+        result["coverage"] = coverage(doc, sp)
+        result["milestones"] = milestones(doc, until)
+        result["left_out"] = excluded
+    else:
+        result["stopped"] = stop
+    result.update(trial_manifest=doc["trial_manifest"],
+                  trial_manifest_sha256=doc["trial_manifest_sha256"],
+                  window=[doc["since"], min(now, until)], target=contract["target"])
+    if target is not None and target != contract["target"]:
+        raise ValueError("fixed measurement target cannot change after assignment")
+    result = canary.measured(result)
+    if not dry_run:
+        save_result(doc, result)
+        canary.record({**result, "at": now, "stage": canary.MEASURE_STAGE,
+                       "branch": doc["branch"], "commit": doc["commit"], "merged": False})
+        canary._decide(doc, result, now)
+        canary.clear(canary.slot_path(slot))
+    log(result["why"])
+    return result
+
+
+def artifact(path):
+    path = Path(path)
+    return {"path":str(path), "sha256":sha(path)} if path.is_file() else {"path":str(path),"missing":True}
+
+
+def code_identity(root):
+    import subprocess
+    try:
+        def git(*args):
+            return subprocess.check_output(["git", "-C", str(root), *args],
+                                           stderr=subprocess.DEVNULL, timeout=5)
+        # Generated coach reports change during a trial; they are not runtime inputs.
+        patch=git("diff", "HEAD", "--", ".", ":(exclude)docs/**", ":(exclude)**/*.md")
+        extra=git("ls-files", "--others", "--exclude-standard", "--", "hive/*.py", "jev/*.py")
+        return {"commit":git("rev-parse", "HEAD").decode().strip(),
+                "dirty":bool(patch or extra), "patch_sha256":hashlib.sha256(patch).hexdigest(),
+                "untracked_source":{p:sha(Path(root)/p) for p in extra.decode().splitlines()}}
+    except (OSError, subprocess.SubprocessError):
+        return {"unavailable":True}
+
+
+def record_environment(recorder, *, graph, paths, parity, coach, guid, seed):
+    evidence={"contract_version":1, "tier":"client-contract-simulator" if parity else "fast-simulator",
+              "code":code_identity(config.JEV), "hive_code":code_identity(config.HOME),
+              "graph_sha256":hashlib.sha256(graph.model_dump_json().encode()).hexdigest(),
+              "artifacts":[artifact(p) for p in paths],
+              "settings":{"parity":sorted(parity), "coach":"model" if coach else "rules",
+                          "trial":os.environ.get("HIVE_TRIAL_TOKEN"), "guid":guid,
+                          "choice_seed":seed, "python_hash_seed":os.environ.get("PYTHONHASHSEED"),
+                          "trip_mode":os.environ.get("JEV_TRIPS", "shadow"),
+                          "trial_manifest":os.environ.get("HIVE_TRIAL_MANIFEST")}}
+    if hasattr(recorder, "environment"):
+        recorder.environment(evidence)
+    else:
+        # Older control code still gets the same manifest, before its first tick.
+        path=recorder.dir/"manifest.json"
+        data=json.loads(path.read_text())
+        if "environment" in data and data["environment"] != evidence:
+            raise ValueError("run environment already sealed")
+        data["environment"]=evidence
+        path.write_text(json.dumps(data, indent=2)+"\n")
+
+
+
+
+def milestones(doc, until, *, db=None):
+    """Next-level endpoints for the full assigned cohort, including right censoring."""
+    from hive import lineage
+    from hive.canary import sqlite_ro
+    db = Path(db or lineage.DB)
+    if not db.exists():
+        return {"available":False, "reason":"no lineage evidence"}
+    con=sqlite_ro(db)
+    rows=[]
+    try:
+        for guid in doc.get('cohort', []):
+            arm='candidate' if config.shard_of_guid(guid,doc['of']) in doc['procs'] else 'control'
+            row={'guid':guid,'arm':arm,'censored':True,'played_s':None}
+            baseline=con.execute('select level,played,at from samples where guid=? and at<=? order by at desc limit 1',
+                                 (guid,doc['since'])).fetchone()
+            if baseline is None or doc['since']-baseline['at']>7200:
+                row['reason']='no fresh baseline'
+                rows.append(row)
+                continue
+            row['target_level']=baseline['level']+1
+            endpoint=con.execute('select played,at from dings where guid=? and level>=? and at>? and at<=? order by at limit 1',
+                                  (guid,row['target_level'],doc['since'],until)).fetchone()
+            if endpoint is not None:
+                row.update(censored=False,played_s=max(0,endpoint['played']-baseline['played']))
+            else:
+                last=con.execute('select played from samples where guid=? and at>? and at<=? order by at desc limit 1',
+                                  (guid,doc['since'],until)).fetchone()
+                if last is not None:
+                    row['played_s']=max(0,last['played']-baseline['played'])
+                row['reason']='next level not observed before fixed-window end'
+            rows.append(row)
+    finally:
+        con.close()
+    return {'available':True,'endpoint':'next level from pre-window baseline',
+            'interpretation':'right-censored observations; completion-only means are not a speed estimate',
+            'rows':rows}
+
+
+if __name__ == "__main__":
+    import argparse
+    parser = argparse.ArgumentParser()
+    parser.add_argument("command", choices=["token"])
+    parser.add_argument("--shard", required=True)
+    args = parser.parse_args()
+    print(token(tuple(int(x) for x in args.shard.split("/"))))
