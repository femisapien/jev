diff --git a/hive/coach_report.py b/hive/coach_report.py
new file mode 100644
index 0000000..6f81a02
--- /dev/null
+++ b/hive/coach_report.py
@@ -0,0 +1,105 @@
+"""Publish coach output without hiding provider failures or inventing a diagnosis."""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import json
+from pathlib import Path
+import subprocess
+import time
+
+
+def read_json(path):
+    try:
+        return json.loads(path.read_text())
+    except (OSError, ValueError):
+        return {}
+
+
+def fallback(var, reason):
+    counts = Counter()
+    for path in var.glob('farm-?.json'):
+        if time.time() - path.stat().st_mtime < 300:
+            counts.update(bot.get('state', 'unknown')
+                          for bot in read_json(path).get('bots', {}).values())
+    experiments = read_json(var / 'experiments.json')
+    lines = ['# Hive coach: evidence-only fallback', '',
+             f'The model diagnosis is unavailable: {reason.strip()[:400]}.',
+             'This report contains recorded measurements, not a source-code diagnosis or a proposed fix.', '',
+             f'Fresh farm status: {dict(counts)}.',
+             f'Experiment report written at Unix time {experiments.get("written", "unknown")}.']
+    for experiment in experiments.get('experiments', []):
+        lines.extend(['', f'## Recorded {experiment["experiment"]} arms'])
+        for name, arm in experiment.get('arms', {}).items():
+            lines.append(f'- {name}: {arm.get("characters")} characters, '
+                         f'{arm.get("hours")} played hours, '
+                         f'{arm.get("deaths_h")} deaths/hour, index {arm.get("index")}.')
+        lines.append('These aggregates do not establish improvement from the newest candidate.')
+    lines.extend(['', 'The full collected evidence is in var/coach-evidence.md. '
+                  'Automated code fixes must wait for a successful model diagnosis.'])
+    return '\n'.join(lines) + '\n'
+
+
+def publish(var, out, stamp, command, *, timeout=1800):
+    var, out = Path(var), Path(out)
+    logs = var / 'logs'
+    logs.mkdir(parents=True, exist_ok=True)
+    out.mkdir(parents=True, exist_ok=True)
+    status_path = var / 'coach-status.json'
+    previous = read_json(status_path)
+    now = time.time()
+    reason = previous.get('reason', '')
+    retry_at = previous.get('retry_at', 0)
+    success = False
+    if now >= retry_at:
+        stdout = logs / f'coach-{stamp}.stdout'
+        stderr = logs / f'coach-{stamp}.stderr'
+        with stdout.open('w') as output, stderr.open('w') as errors:
+            try:
+                result = subprocess.run(command, stdin=subprocess.DEVNULL, stdout=output,
+                                        stderr=errors, timeout=timeout, check=False)
+                code = result.returncode
+            except subprocess.TimeoutExpired:
+                code = 124
+            except OSError as exc:
+                errors.write(str(exc))
+                code = 127
+        text = stdout.read_text().strip()
+        success = code == 0 and bool(text)
+        if success:
+            report = text + '\n'
+            reason, retry_at = '', 0
+        else:
+            reason = (text or stderr.read_text().strip() or f'provider exited {code}')[:1000]
+            retry_at = now + (6 * 3600 if 'limit' in reason.lower() else 1800)
+    if not success:
+        report = fallback(var, reason)
+    path = out / f'{stamp}.md'
+    path.write_text(report)
+    # Keep the last model diagnosis separate; a fallback must never become fixer input.
+    (out / 'latest.md').write_text(report)
+    if success:
+        (out / 'latest-diagnosis.md').write_text(report)
+    status = {'at': time.time(), 'state': 'ready' if success else 'degraded',
+              'reason': reason, 'retry_at': retry_at, 'report': str(path),
+              'model_diagnosis': success}
+    status_path.write_text(json.dumps(status, indent=2) + '\n')
+    print(f'coach: {status["state"]}; report {path}')
+    return status
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--var', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    parser.add_argument('--stamp', required=True)
+    parser.add_argument('command', nargs=argparse.REMAINDER)
+    args = parser.parse_args()
+    command = args.command[1:] if args.command[:1] == ['--'] else args.command
+    if not command:
+        parser.error('provider command required')
+    publish(args.var, args.out, args.stamp, command)
+
+
+if __name__ == '__main__':
+    main()
